# ==================== 基础配置 ====================
# 服务端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# 时区（默认东八区北京时间）
TZ=Asia/Shanghai

# ==================== 认证配置 ====================
# JWT 密钥（生产环境必须修改为强随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# ==================== 数据库 ====================
# 数据库文件路径
DB_PATH=./data/fileshare.db

# ==================== 存储 ====================
# 文件存储路径
STORAGE_PATH=./storage

# 单文件最大大小（字节，默认 10GB）
# MAX_FILE_SIZE=10737418240

# 单次表单上传大小上限（字节，默认 50MB）；超过则需使用分块上传，避免大文件导致宕机
# SINGLE_UPLOAD_MAX=52428800

# 请求体大小限制（大文件上传需足够大，默认 500mb）
# BODY_SIZE_LIMIT=500mb

# 大文件上传超时（毫秒，无 Nginx 时 Node 默认约 5 分钟；75MB 慢速网络可设为 600000 即 10 分钟）
# UPLOAD_TIMEOUT_MS=600000

# Office 预览转换命令（可选）
# 用于 PPT/PPTX 在内网环境下自动转换为 PDF 预览；未配置时会自动尝试 soffice/libreoffice
# LIBREOFFICE_PATH=/usr/bin/soffice

# Office 转换超时（毫秒）
# OFFICE_CONVERT_TIMEOUT_MS=120000

# Office 预览缓存总大小上限（MB），超过后自动清理最旧的 PDF 缓存
# OFFICE_PREVIEW_CACHE_LIMIT_MB=2048

# Office 预览缓存清理目标（MB），触发清理后会尽量降到该值以下
# OFFICE_PREVIEW_CACHE_TARGET_MB=1536

# ==================== 安全与限流 ====================
# CORS 允许的客户端地址（逗号分隔，* 表示允许所有）
# 生产环境部署到 ip:port 时，可设为 * 或具体地址
CLIENT_URL=http://localhost:5173

# 限流：每个 IP 15 分钟内最大请求数
RATE_LIMIT_MAX=1000

# ==================== 加密（可选） ====================
# 加密模式：none | sm4 | aes256 | external
# ENCRYPTION_MODE=none

# 加密密钥（32 字符，启用加密时必填）
# ENCRYPTION_KEY=your-32-character-encryption-key-here

# ==================== 清理策略 ====================
# 回收站保留天数
# TRASH_RETENTION_DAYS=30

# 版本历史保留天数
# VERSION_RETENTION_DAYS=30

# 操作日志保留天数
# LOG_RETENTION_DAYS=90

# ==================== Wiki 知识库（v1.0.14+） ====================
# Wiki 回收站保留天数（独立于文件回收站，过期后自动彻底删除含级联清理）
# WIKI_TRASH_RETENTION_DAYS=30

# ==================== Puppeteer / PDF 导出（v1.0.14+） ====================
# Wiki 单页/整库导出 PDF 依赖 puppeteer（已在核心依赖）。npm install 时默认会自动下载 ~250MB 的 Chromium。
#
# 如部署在受限网络（无外网 / 内网代理）：
#   1) 安装阶段跳过 Chromium 下载：
#      PUPPETEER_SKIP_DOWNLOAD=1
#   2) 运行时指定系统已装的 Chrome / Chromium 二进制（必填）：
#      Linux:   PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
#      Linux:   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
#      macOS:   PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
#      Windows: PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# PUPPETEER_SKIP_DOWNLOAD=
# PUPPETEER_EXECUTABLE_PATH=

# ==================== 前端开发（可选） ====================
# 开发时前端代理目标，用于连接远程 API
# VITE_API_URL=http://192.168.1.100:3000
